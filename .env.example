# .env.local 로 복사해서 값을 채우세요. 실제 값은 Git에 올리지 않습니다.
# 모든 값은 서버(파이썬)에서만 읽습니다. 브라우저로 전달되지 않습니다.

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_... 또는 service_role 키 (서버 전용)
SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_... (로그인·토큰 갱신용, 권장)

# ---------- LLM (OpenAI GPT) ----------
LLM_API_KEY=                    # https://platform.openai.com/api-keys 에서 발급
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none       # gpt-6-luna 함수 호출에 필요. 추론 기능 없는 모델이면 비워 두기
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536       # DB vector(1536)과 반드시 일치
EMBEDDING_SEND_DIMENSIONS=false # 임베딩 API가 dimensions 파라미터를 지원할 때만 true

# 선택: fetch_lms_document가 URL로 교안을 가져올 수 있는 호스트(쉼표 구분). 비우면 URL 가져오기 비활성화
LMS_ALLOWED_HOSTS=
