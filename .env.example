# .env.local 로 복사해서 값을 채우세요. 실제 값은 Git에 올리지 않습니다.
# 모든 값은 서버(파이썬)에서만 읽습니다. 브라우저로 전달되지 않습니다.

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_... 또는 service_role 키 (서버 전용)
SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_... (로그인·토큰 갱신용, 권장)

# ---------- LLM (OpenAI GPT) ----------
LLM_API_KEY=                    # https://platform.openai.com/api-keys 에서 발급
LLM_BASE_URL=https://api.openai.com/v1
LLM_CHAT_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none       # gpt-6-luna 함수 호출에 필요. 추론 기능 없는 모델이면 비워 두기
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536       # DB vector(1536)과 반드시 일치
EMBEDDING_SEND_DIMENSIONS=false # 임베딩 API가 dimensions 파라미터를 지원할 때만 true

# 선택: fetch_lms_document가 URL로 교안을 가져올 수 있는 호스트(쉼표 구분). 비우면 URL 가져오기 비활성화
LMS_ALLOWED_HOSTS=

# ---------- 가상 LMS 연동 ----------
LMS_API_KEY=                    # 도우미 ↔ 가상 LMS 서버 간 비밀 키 (임의의 긴 문자열, 32자 이상 권장)
LMS_API_BASE_URL=               # 학사정보 API. 비우면 같은 앱 안의 가상 학사정보(/lms/api)를 직접 호출
MOODLE_BASE_URL=                # 코스모스(Moodle) 주소. 비우면 가상 코스모스. 학교 허가 후 https://코스모스주소 로 교체

# ---------- Web Push 알림 ----------
VAPID_PUBLIC_KEY=               # 브라우저 구독용 공개 키 (생성 명령은 README 참고)
VAPID_PRIVATE_KEY=              # 푸시 서명용 비밀 키 (서버 전용)
VAPID_SUBJECT=mailto:you@example.com   # 푸시 서비스가 문제 시 연락할 주소

# ---------- 학기 달력 (선택) ----------
# '저번주 자바 내용 알려줘'처럼 주차를 계산할 때 쓴다. 1주차가 시작하는 월요일 (비우면 2026-2학기 기본값)
SEMESTER_LABEL=2026-2학기
SEMESTER_START=2026-08-31

# ---------- 매일 알림 (Vercel Cron) ----------
CRON_SECRET=                    # 16자 이상 임의 문자열. Vercel이 Authorization: Bearer 로 보내 줌
