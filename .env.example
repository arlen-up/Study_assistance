# .env.local 로 복사해서 값을 채우세요. 실제 값은 Git에 올리지 않습니다.

# ---------- 프론트엔드 (브라우저에 노출돼도 되는 공개 값) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- 백엔드 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것) ----------
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # sb_secret_... 또는 service_role 키 (서버에서만 사용)

TILON_API_KEY=
TILON_BASE_URL=                 # OpenAI 호환 엔드포인트, 예: https://<tilon-host>/v1
TILON_CHAT_MODEL=
TILON_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536       # DB vector(1536)과 반드시 일치
EMBEDDING_SEND_DIMENSIONS=false # 임베딩 API가 dimensions 파라미터를 지원할 때만 true

# 선택: fetch_lms_document가 URL로 교안을 가져올 수 있는 호스트(쉼표 구분). 비우면 URL 가져오기 비활성화
LMS_ALLOWED_HOSTS=
